# Repo-wide overview of the env vars this project reads. Per-service copies
# with more detail live in api/.env.example and web/.env.example - copy
# whichever ones you need to a sibling `.env` (both are gitignored).

# --- Backend (api/) -----------------------------------------------------
# Comma-separated origins allowed to call POST /rooms and open a WebSocket
# (the deployed frontend + local dev).
ALLOWED_ORIGINS=http://localhost:5173
# Port the server binds. Fly/Render inject their own; the Dockerfile falls
# back to 8000 if unset.
PORT=8000

# --- Frontend (web/), build-time only ------------------------------------
# HTTPS origin of the deployed backend.
VITE_API_URL=http://localhost:8000
# WSS origin of the deployed backend (wss:// in production).
VITE_WS_URL=ws://localhost:8000

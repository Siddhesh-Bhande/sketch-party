# Backend runtime settings (read by sketch_party.config.Settings via
# pydantic-settings, from a `.env` file in this directory or from the real
# process environment in deployment). Copy to `.env` for local overrides;
# both `.env` and the copy are gitignored.

# Comma-separated list of origins allowed to call POST /rooms and open the
# /ws/{code} WebSocket. Must be the exact scheme+host+port of the deployed
# frontend (e.g. https://sketch-party.vercel.app), not a wildcard.
ALLOWED_ORIGINS=http://localhost:5173

# Port uvicorn binds. Fly (and most PaaS targets) inject this themselves;
# only set it explicitly for local runs that don't use the Dockerfile's
# ${PORT:-8000} default.
PORT=8000

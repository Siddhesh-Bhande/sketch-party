# Frontend build-time settings (read by web/src/config.ts via
# `import.meta.env`, baked into the bundle at build time - not
# reconfigurable at runtime). Copy to `.env` for local overrides; both
# `.env` and the copy are gitignored. Vercel project settings should define
# the same two variables for production builds.

# HTTPS origin of the deployed backend, used for POST /rooms.
VITE_API_URL=http://localhost:8000

# WSS origin of the deployed backend, used for the /ws/{code} connection.
# Must use the wss:// scheme in production (plain ws:// is fine for the
# local http backend above).
VITE_WS_URL=ws://localhost:8000
